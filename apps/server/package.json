    "db:verify": "node dist/scripts/verifyDatabase.js",
    "demo:seed": "node dist/scripts/seedDemoData.js",
    "demo:blockchain": "node dist/scripts/demoBlockchainRoundtrip.js",
    "demo:audit": "node dist/scripts/demoAuditRoundtrip.js",
    "experiment:tamper": "node dist/scripts/runTamperExperiment.js",
    "verify:api": "node dist/scripts/verifyApiRoundtrip.js",
